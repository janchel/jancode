# Secrets & credentials — never commit these
.env
.env.*
!.env.example
*.env
config.toml
*.key
*.pem
*.crt
*.p12
*.jcode-backup
*.jancode-backup

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# Config dirs / sockets created by the app at runtime
.jancode/
jancode.sock
/data/
/run/jcode/
/run/jancode/