# Rust build artifacts
target/

# Local runtime / logs
daemon.log
*.log

# Local notes / scratch files (may contain keys, credentials, or plans)
*.txt
*.tmp
*.swp
*~

# Changelogs are local keep-notes, not part of the published repo
changelog
changelog*
CHANGELOG.md
CHANGELOG*
PERFORMANCE_PLAN.md
